# Everything the app writes at runtime. Nothing here belongs in the repo: it is
# either your own data, a cache that rebuilds itself, or a generated file.

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/

# --- Logs & crash reports ---
# Matches data/logs/ too, including logs/last_error.log and the raw IBKR Flex
# report dumped for diagnosis (it contains your account's trade history).
logs/

# --- Your data ---
# The app now keeps your portfolio, journal, alerts and notes in
# %LOCALAPPDATA%\TradeLab Pro, outside this checkout entirely (see
# config.user_data_dir). These two folders are what older versions wrote here -
# data.old is the pre-move backup - and both are ignored wholesale rather than
# file by file: everything inside them is yours, including imported IBKR
# positions, and none of it belongs in a public repo.
data/
data.old/

# --- Generated ---
# Built from docs/USER_MANUAL.md by tools/build_manual_html.py. Rebuild it
# before publishing rather than editing it; committing it would let the page
# drift from the markdown the in-app Help viewer reads.
docs/USER_MANUAL.html

# The icon's contact sheet, for eyeballing the small sizes. tradelab.ico itself
# IS committed: the app loads it at runtime and the build embeds it, and Pillow
# (needed to regenerate it) is not a runtime dependency.
resources/tradelab_preview.png
