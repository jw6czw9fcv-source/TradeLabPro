# Repo-wide ignores: tooling, editor and OS clutter that can turn up anywhere.
# Anything the app itself writes is listed in the app folder's own .gitignore,
# next to the paths it applies to.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Build output ---
# The .exe and PyInstaller's scratch folder are generated; rebuild them rather
# than committing 129 MB. TradeLabPro.spec is the opposite - it is hand-written
# source that describes how to build, so it stays tracked.
build/
dist/
dist_debug/

# --- Editors & IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
